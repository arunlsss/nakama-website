rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member() {
   return request.auth != null
    && request.auth.token.nakamaRole in ['viewer','importer','admin']
    && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.enabled == true
    && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == request.auth.token.nakamaRole;
  }
  match /workspace/main { allow get: if member(); }
  match /{document=**} { allow read, write: if false; }
 }
}
